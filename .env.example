# abysstract-admin 后端环境变量样例
#
# 用法：首次启动前复制本文件为 .env 并按需修改：
#   cp .env.example .env
#
# 说明：.env 已在 .gitignore 中忽略，请勿提交真实密钥。
# 本文件仅提供占位值，生产环境务必覆盖所有安全相关项（JWT 密钥、CORS、数据库连接）。

# ---- 运行模式与监听 ----
# 运行模式：dev | prod（prod 下会强制安全检查，拒绝使用不安全默认值）
ADMIN_ENV=dev
# 后端 HTTP 监听地址
ADMIN_ADDR=:8080

# ---- 独立 admin 数据库（不指向 RAG 的 gridrag）----
# 与 docker-compose.yml 的 admin-postgres 对齐：宿主机端口 5433，库名 abysstract_admin
# 数据库要求与连接配置见 docs/configuration.md。driver 与 DSN 显式成对设置。
# SQLite 本机文件：ADMIN_DB_DRIVER=sqlite，ADMIN_DB_DSN=file:/absolute/path/admin.sqlite
# 构建需要 CGO_ENABLED=1 和 C 编译器；文件目录预先创建。部署边界见 docs/configuration.md。
# MySQL / MariaDB 示例：ADMIN_DB_DRIVER=mysql 或 mariadb
# ADMIN_DB_DSN=app:password@tcp(127.0.0.1:3306)/admin_app
ADMIN_DB_DRIVER=postgres
ADMIN_DB_DSN=host=localhost port=5433 user=admin password=admin dbname=abysstract_admin sslmode=disable

# ---- 安全 ----
# JWT 签名密钥（生产环境必须替换为强随机值）
ADMIN_JWT_SECRET=change-me-in-production
# JWT 有效期（秒），默认 3600
ADMIN_JWT_EXPIRES_SECONDS=3600
# 允许的跨域来源（逗号分隔；生产环境必须显式指定，禁止通配 *）
ADMIN_CORS_ORIGINS=http://localhost:5173
# 前面有一层反向代理时设为 true：客户端 IP 取 X-Forwarded-For 最右侧的地址（代理追加的那一项）
ADMIN_TRUST_PROXY=false
# 多层代理（如 CDN → Nginx）时列出可信代理网段，逗号分隔，例如 10.0.0.0/8,127.0.0.1
# 设置后只有直连对端在其中时才读 X-Forwarded-For，从右向左跳过这些网段取客户端 IP
ADMIN_TRUSTED_PROXIES=
# /metrics 访问令牌：设置后需 Authorization: Bearer <token>；未设置时开发模式开放、生产模式关闭
ADMIN_METRICS_TOKEN=

# ---- 刷新令牌（需求 6.10/6.11，默认关闭）----
# 是否启用刷新令牌特性（true/false）。启用后 LoginResponse 携带 refresh_token，
# 可通过 RefreshToken RPC 换取新的 access token。
ADMIN_REFRESH_TOKEN_ENABLED=false
# 刷新令牌有效期（秒），必须大于 ADMIN_JWT_EXPIRES_SECONDS，默认 7 天。
ADMIN_JWT_REFRESH_EXPIRES_SECONDS=604800

# ---- 可观测 / 运行时 ----
# 优雅停机超时（秒），取值范围 1–300，默认 30
ADMIN_SHUTDOWN_TIMEOUT_SECONDS=30
# 数据库连接池：最大连接数（1–1000）与最大空闲连接数（0..最大连接数）
ADMIN_DB_MAX_OPEN_CONNS=20
ADMIN_DB_MAX_IDLE_CONNS=10

# ---- 登录安全（见 docs/configuration.md#登录安全）----
# 连续登录失败达到该次数后锁定账号；不设置时未启用验证码为 5，启用验证码为 20
ADMIN_LOGIN_MAX_FAILURES=
# 账号锁定时长（秒），默认 900
ADMIN_LOGIN_LOCKOUT_SECONDS=900
# 同一 IP 失败计数的窗口（秒），默认 900；IPv6 按 /64 计数
ADMIN_LOGIN_IP_WINDOW_SECONDS=900
# 未启用验证码时，同一 IP 在窗口内失败达到该次数后拒绝登录，默认 30
ADMIN_LOGIN_IP_MAX_FAILURES=30
# 验证码：slide（内置滑块，不依赖外部服务）| turnstile | hcaptcha；留空不启用
ADMIN_CAPTCHA_PROVIDER=
# 第三方验证服务的密钥与站点密钥（slide 不需要）
ADMIN_CAPTCHA_SECRET=
ADMIN_CAPTCHA_SITE_KEY=
# 启用验证码后：同一用户名连续失败达到该次数要求验证码，默认 3
ADMIN_LOGIN_CAPTCHA_AFTER=3
# 启用验证码后：同一 IP 在窗口内失败达到该次数要求验证码，默认 10
ADMIN_LOGIN_IP_CAPTCHA_AFTER=10

# ---- 上传限制 ----
# 通用文件上传大小上限（字节），默认 50MB
ADMIN_UPLOAD_MAX_BYTES=52428800
# 头像上传大小上限（字节），默认 5MB
ADMIN_AVATAR_MAX_BYTES=5242880
# 本地存储驱动的文件目录（相对或绝对路径；默认 ./uploads）
ADMIN_UPLOAD_DIR=./uploads

# ---- 文件存储（详见 docs/storage.md）----
# 驱动：local（默认，文件存放在 ADMIN_UPLOAD_DIR，经 /static/ 访问）| s3（S3 / MinIO / R2）
ADMIN_STORAGE_DRIVER=local
# 文件访问 URL 前缀（CDN 或公开域名）；留空时 local 为 /static/，s3 按桶地址推导
ADMIN_STORAGE_PUBLIC_BASE_URL=
# 预签名直传有效期（秒），1–604800，默认 900
ADMIN_STORAGE_UPLOAD_TTL_SECONDS=900
# local 驱动的上传签名密钥（至少 16 字节）；留空时由 ADMIN_JWT_SECRET 派生
ADMIN_STORAGE_SIGNING_SECRET=
# s3 驱动：存储桶与区域必填（R2 区域填 auto）；凭据走 AWS 标准凭据链（AWS_ACCESS_KEY_ID 等）
ADMIN_STORAGE_S3_BUCKET=
ADMIN_STORAGE_S3_REGION=
# S3 兼容服务地址，例如 MinIO：http://localhost:9000
ADMIN_STORAGE_S3_ENDPOINT=
# 路径风格寻址（endpoint/bucket/key），MinIO 通常需要 true
ADMIN_STORAGE_S3_PATH_STYLE=false

# ---- 请求日志（详见 docs/access-log.md）----
# sink 列表，逗号分隔：db（sys_access_log 表，后台「请求日志」页面查询）| stdout（每行一个 JSON）
# 设置为空或 none 关闭请求日志
ADMIN_ACCESS_LOG_SINKS=db,stdout
# 待写队列容量；队列满时丢弃新记录，不阻塞请求
ADMIN_ACCESS_LOG_QUEUE_SIZE=4096
# 每批写入条数与最长等待（毫秒）
ADMIN_ACCESS_LOG_BATCH_SIZE=200
ADMIN_ACCESS_LOG_FLUSH_INTERVAL_MS=1000
# db sink 保留天数，0 为永久保留
ADMIN_ACCESS_LOG_RETENTION_DAYS=30
# 是否在本进程清理过期记录；多个进程写同一个表时，只在一个进程中保留 true
ADMIN_ACCESS_LOG_PURGE=true
