# abysstract-admin 后端环境变量样例
#
# 用法：首次启动前复制本文件为 .env 并按需修改：
#   cp .env.example .env
#
# 说明：.env 已在 .gitignore 中忽略，请勿提交真实密钥。
# 本文件仅提供占位值，生产环境务必覆盖所有安全相关项（JWT 密钥、CORS、数据库连接）。

# ---- 运行模式与监听 ----
# 运行模式：dev | prod（prod 下会强制安全检查，拒绝使用不安全默认值）
ADMIN_ENV=dev
# 后端 HTTP 监听地址
ADMIN_ADDR=:8080

# ---- 独立 admin 数据库（不指向 RAG 的 gridrag）----
# 与 docker-compose.yml 的 admin-postgres 对齐：宿主机端口 5433，库名 abysstract_admin
# 数据库要求与连接配置见 docs/configuration.md。driver 与 DSN 显式成对设置。
# SQLite 本机文件：ADMIN_DB_DRIVER=sqlite，ADMIN_DB_DSN=file:/absolute/path/admin.sqlite
# 构建需要 CGO_ENABLED=1 和 C 编译器；文件目录预先创建。部署边界见 docs/configuration.md。
# MySQL / MariaDB 示例：ADMIN_DB_DRIVER=mysql 或 mariadb
# ADMIN_DB_DSN=app:password@tcp(127.0.0.1:3306)/admin_app
ADMIN_DB_DRIVER=postgres
ADMIN_DB_DSN=host=localhost port=5433 user=admin password=admin dbname=abysstract_admin sslmode=disable

# ---- 安全 ----
# JWT 签名密钥（生产环境必须替换为强随机值）
ADMIN_JWT_SECRET=change-me-in-production
# JWT 有效期（秒），默认 3600
ADMIN_JWT_EXPIRES_SECONDS=3600
# 允许的跨域来源（逗号分隔；生产环境必须显式指定，禁止通配 *）
ADMIN_CORS_ORIGINS=http://localhost:5173
# 是否信任反向代理的 X-Forwarded-For（取客户端真实 IP）
ADMIN_TRUST_PROXY=false
# /metrics 访问令牌：设置后需 Authorization: Bearer <token>；未设置时开发模式开放、生产模式关闭
ADMIN_METRICS_TOKEN=

# ---- 刷新令牌（需求 6.10/6.11，默认关闭）----
# 是否启用刷新令牌特性（true/false）。启用后 LoginResponse 携带 refresh_token，
# 可通过 RefreshToken RPC 换取新的 access token。
ADMIN_REFRESH_TOKEN_ENABLED=false
# 刷新令牌有效期（秒），必须大于 ADMIN_JWT_EXPIRES_SECONDS，默认 7 天。
ADMIN_JWT_REFRESH_EXPIRES_SECONDS=604800

# ---- 可观测 / 运行时 ----
# 优雅停机超时（秒），取值范围 1–300，默认 30
ADMIN_SHUTDOWN_TIMEOUT_SECONDS=30
# 数据库连接池：最大连接数（1–1000）与最大空闲连接数（0..最大连接数）
ADMIN_DB_MAX_OPEN_CONNS=20
ADMIN_DB_MAX_IDLE_CONNS=10

# ---- 登录安全 ----
# 连续登录失败达到该次数后锁定账号，默认 5
ADMIN_LOGIN_MAX_FAILURES=5
# 账号锁定时长（秒），默认 900
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# ---- 上传限制 ----
# 通用文件上传大小上限（字节），默认 50MB
ADMIN_UPLOAD_MAX_BYTES=52428800
# 头像上传大小上限（字节），默认 5MB
ADMIN_AVATAR_MAX_BYTES=5242880
# 上传文件保存目录（相对或绝对路径；默认 ./uploads）
ADMIN_UPLOAD_DIR=./uploads
